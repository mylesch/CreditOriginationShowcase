{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/account-checks",
    "bodyPatterns": [
      {"matchesJsonPath": {"expression": "$.accountNumber", "equalTo": "BC06-ACCT"}}
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "reference": "{{jsonPath request.body '$.reference'}}",
      "resultCode": "BC06",
      "resultDescription": "Pending at bureau",
      "accountStatus": "OPEN",
      "ownerNameMatchScore": null,
      "checkedOn": "{{now}}",
      "status": "COMPLETE",
      "error": null
    },
    "transformers": ["response-template"]
  }
}
