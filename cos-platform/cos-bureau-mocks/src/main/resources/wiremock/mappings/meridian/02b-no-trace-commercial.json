{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v2/credit-reports",
    "bodyPatterns": [
      {"matchesJsonPath": {"expression": "$.subject.companyRegistrationNumber", "equalTo": "NOTRACE-REG"}}
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "reference": "{{jsonPath request.body '$.reference'}}",
      "reportDate": "{{now format='yyyy-MM-dd'}}",
      "recordFound": false,
      "status": "COMPLETE"
    },
    "transformers": ["response-template"]
  }
}
