{
  "priority": 1,
  "scenarioName": "northgate-kyc-retry",
  "requiredScenarioState": "ATTEMPT_3",
  "request": {
    "method": "POST",
    "urlPath": "/v1/individuals/verify",
    "headers": {"X-Test-Scenario": {"equalTo": "retry-then-success"}}
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "requestId": "{{jsonPath request.body '$.requestId'}}",
      "status": "COMPLETED",
      "result": {
        "matchOutcome": "MATCH",
        "matchConfidence": 97.5,
        "matchedFields": ["firstName", "lastName", "dateOfBirth", "identificationNumber"],
        "identificationStatus": "VALID",
        "watchlistChecked": false
      },
      "subjectReference": "NG-SUBJ-{{randomValue length=8 type='ALPHANUMERIC'}}",
      "generatedOn": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}
