{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/companies/verify",
    "bodyPatterns": [
      {"matchesJsonPath": {"expression": "$.subject.registrationNumber", "equalTo": "DEREG-REG"}}
    ]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "requestId": "{{jsonPath request.body '$.requestId'}}",
      "status": "COMPLETED",
      "result": {"matchOutcome": "MATCH", "matchConfidence": 97.5, "registrationStatus": "DEREGISTERED"},
      "generatedOn": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}
